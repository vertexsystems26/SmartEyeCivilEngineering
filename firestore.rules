rules_version = '2';

// S.E.C.E – Firestore security rules.
// Roles live in users/{uid}.role: admin | editor | sales (brief §7.3).
// Deploy: Firebase console → Firestore → Rules → paste this file → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function role() {
      return get(profilePath()).data.role;
    }
    function isAdmin() {
      return hasProfile() && role() == 'admin';
    }
    function isEditor() {
      return hasProfile() && role() in ['admin', 'editor'];
    }
    function isSales() {
      return hasProfile() && role() in ['admin', 'sales'];
    }
    function invitationPath() {
      return /databases/$(database)/documents/invitations/$(request.auth.token.email.lower());
    }
    // The company mailbox becomes the first administrator once its address is verified.
    function isBootstrapOwner() {
      return verified() && request.auth.token.email.lower() == 'smarteyecivilengineering@gmail.com';
    }

    // ---------- Users and invitations ----------

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && (
          (isBootstrapOwner() && request.resource.data.role == 'admin')
          || (verified() && exists(invitationPath())
              && request.resource.data.role == get(invitationPath()).data.role)
        );
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /invitations/{email} {
      allow read: if isAdmin() || (verified() && request.auth.token.email.lower() == email);
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'editor', 'sales'];
      // Consumed by the invited person once their profile exists.
      allow delete: if isAdmin() || (verified() && request.auth.token.email.lower() == email);
    }

    // ---------- Content ----------

    function publishedOrEditor() {
      return resource.data.status == 'published' || isEditor();
    }

    match /services/{id} {
      allow read: if publishedOrEditor();
      allow write: if isEditor();
      match /versions/{v} { allow read, write: if isEditor(); }
    }
    match /projects/{id} {
      allow read: if publishedOrEditor();
      allow write: if isEditor();
      match /versions/{v} { allow read, write: if isEditor(); }
    }
    match /posts/{id} {
      allow read: if publishedOrEditor();
      allow write: if isEditor();
      match /versions/{v} { allow read, write: if isEditor(); }
    }
    match /categories/{id} {
      allow read: if publishedOrEditor();
      allow write: if isEditor();
      match /versions/{v} { allow read, write: if isEditor(); }
    }

    // Page singletons are public; site-wide configuration is admin-only (brief §7.3).
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (isEditor() && docId in ['about', 'home', 'legal']);
      match /versions/{v} { allow read, write: if isEditor(); }
    }

    match /media/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ---------- Inbox (phase 3) ----------

    match /messages/{id} {
      allow read, update, delete: if isSales();
    }
    match /quotes/{id} {
      allow read, update, delete: if isSales();
    }

    // ---------- Audit log: append-only ----------

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if (isEditor() || isSales()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
