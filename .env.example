# ---------------------------------------------------------------------------
# S.E.C.E – variables d'environnement
# Copier en .env.local (développement) ; en production, déclarer les secrets
# avec `npx wrangler secret put NOM` et les valeurs publiques dans wrangler.jsonc.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://smarteyecivilengineering.com
# production = indexable ; toute autre valeur (development, preview) = noindex partout
NEXT_PUBLIC_SITE_ENV=development

# Cloudflare (compte et R2)
CLOUDFLARE_ACCOUNT_ID=
# Jeton d'API limité à R2 (ne pas le nommer CLOUDFLARE_API_TOKEN : wrangler l'utiliserait pour déployer)
CLOUDFLARE_R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Bucket public (médias du site, servis par le domaine ci-dessous) et bucket privé (pièces jointes des devis)
R2_PUBLIC_BUCKET=sece-storage
R2_PRIVATE_BUCKET=sece-private
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.smarteyecivilengineering.com

# Firebase – configuration web (publique par conception, protégée par les règles Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase – compte de service (serveur uniquement, phase 2)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Formulaires (phase 3)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=smarteyecivilengineering@gmail.com

# Suivi des erreurs (phase 7)
SENTRY_DSN=
